{
  "lanes": [
    {
      "name": "Shader pack (Iris)",
      "sub": "the pack draws the world with its own shaders"
    },
    {
      "name": "Scene depth",
      "sub": "depth EXIT copies while the pack is halfway through the frame"
    },
    {
      "name": "EXIT channels",
      "sub": "the mod's own objects, drawn with vanilla shaders"
    },
    {
      "name": "Merge",
      "sub": "at the end of the frame, blended back over the pack's image by depth"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "frame start",
      "title": "Shadow pass",
      "text": "The pack draws its shadow map. EXIT draws nothing here.",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "throughout level rendering",
      "title": "Mod submits draws",
      "text": "<code>Exit.batch</code>, <code>draw</code> and <code>portal</code> first collect what to draw, then draw it into EXIT's channels after the pack finishes.",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "Pack draws opaque world",
      "text": "Super Resolution makes the pack draw only into 1/1.21 of the window: window 854×480, scene 705×396. The depth buffer is still 854×480, and only the lower-left corner (dashed box) is used.",
      "imgs": [
        {
          "src": "img/sr/01-pack-depth-before-hand.png",
          "caption": "pack depth (854×480)",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "Copy: depth without hand",
      "text": "EXIT reads the scene size 705×396 from SR and copies from the lower-left corner at that size. What it gets is exactly the whole scene, so no resampling is needed.",
      "imgs": [
        {
          "src": "img/sr/02-no-hand-copy.png",
          "caption": "copy (705×396)",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "Pack draws the hand",
      "text": "The hand is also drawn in this lower-left block.",
      "imgs": [
        {
          "src": "img/sr/03-pack-depth-before-translucents.png",
          "caption": "depth with hand (854×480)",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "first beginHand",
      "title": "No scale measurement",
      "text": "While SR is in use, EXIT does not draw the probe. SR's downscale is already handled by the scene size, and measuring again would shrink the scene twice.",
      "imgs": []
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water etc.",
      "title": "Pack draws translucents",
      "text": "The pale blue glass is written to depth.",
      "imgs": [
        {
          "src": "img/sr/06-main-depth-end.png",
          "caption": "depth with glass (854×480)",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "Copy: depth without translucents",
      "text": "Has the hand, no glass. Likewise copied at the scene size.",
      "imgs": [
        {
          "src": "img/sr/04-opaque-copy.png",
          "caption": "copy (705×396)",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final → SR",
      "title": "Pack's finished frame",
      "text": "After the pack finishes, SR (FSR2 here) upscales 705×396 to the whole window. There are no mod objects in the image yet.",
      "imgs": [
        {
          "src": "img/sr/05-pack-frame.png",
          "caption": "upscaled finished image (854×480)",
          "size": [
            854,
            480
          ]
        }
      ]
    },
    {
      "id": "mainEnd",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "end of frame",
      "title": "Final depth, no alignment",
      "text": "The final depth used to find the glass at merge time also reads only the lower-left 705×396 block, and its pixels line up one-to-one with the channels.",
      "imgs": [
        {
          "src": "img/sr/06-main-depth-end.png",
          "caption": "read from inside the dashed box",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "end of frame · first use of the channel",
      "title": "Seed the channel",
      "text": "The channel is the same size as the scene (705×396). Seed it with \"depth without translucents\" and set the hand's position to nearest; the see-through channel only holds the hand.",
      "imgs": [
        {
          "src": "img/sr/09-main-seeded.png",
          "caption": "main channel",
          "size": [
            705,
            396
          ]
        },
        {
          "src": "img/sr/08-debug_xray-seeded.png",
          "caption": "see-through channel",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "vanilla shaders",
      "title": "Draw into the channel",
      "text": "Green writes color and depth. Red is translucent: the stone cuts off its lower-right corner, and it does not write depth.",
      "imgs": [
        {
          "src": "img/sr/10-main-color.png",
          "caption": "main channel color",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/11-main-depth.png",
          "caption": "main channel depth",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "before merging",
      "title": "Add the translucent depth",
      "text": "The translucent objects are drawn again, writing only depth, and then folded into the channel's depth.",
      "imgs": [
        {
          "src": "img/sr/12-main-translucent-depth.png",
          "caption": "translucent depth",
          "size": [
            705,
            396
          ]
        },
        {
          "src": "img/sr/13-main-depth-folded.png",
          "caption": "folded",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "others",
      "lane": 3,
      "row": 10,
      "kind": "channel",
      "when": "each channel",
      "title": "Other channels, same treatment",
      "text": "The yellow block is in the mix channel; the blue block and the cyan wireframe are in the see-through channel.",
      "imgs": [
        {
          "src": "img/sr/14-debug_mix-color.png",
          "caption": "mix channel",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/18-debug_xray-color.png",
          "caption": "see-through channel",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        }
      ]
    },
    {
      "id": "handMask",
      "lane": 2,
      "row": 9,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the hand",
      "text": "The pixels where the \"with hand\" and \"without hand\" depths differ are the hand (orange).",
      "imgs": [
        {
          "src": "img/sr/22-hand-mask.png",
          "caption": "hand position",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "transMask",
      "lane": 2,
      "row": 10,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the translucents",
      "text": "Where the final depth is nearer than \"depth without translucents\", there is glass (orange). Only the dashed box is checked.",
      "imgs": [
        {
          "src": "img/sr/23-translucent-in-front.png",
          "caption": "glass position (854×480)",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "layer1",
      "lane": 4,
      "row": 11,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the first channel",
      "text": "The main channel drops the hand's pixels, and the lower half of the green behind the glass is darkened.",
      "imgs": [
        {
          "src": "img/sr/24-layer-after-main.png",
          "caption": "blend layer",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/25-layer-depth-after-main.png",
          "caption": "blend layer depth",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        }
      ]
    },
    {
      "id": "layer2",
      "lane": 4,
      "row": 12,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the mix channel by depth",
      "text": "The nearer one is in front: the green covers the overlapping part of the yellow.",
      "imgs": [
        {
          "src": "img/sr/26-layer-after-debug_mix.png",
          "caption": "blend layer",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/27-layer-depth-after-debug_mix.png",
          "caption": "blend layer depth",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        }
      ]
    },
    {
      "id": "layer3",
      "lane": 4,
      "row": 13,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the see-through channel",
      "text": "The blue block and the wireframe are added to the blend layer.",
      "imgs": [
        {
          "src": "img/sr/28-layer-after-debug_xray.png",
          "caption": "blend layer",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/29-layer-depth-after-debug_xray.png",
          "caption": "blend layer depth",
          "size": [
            705,
            396
          ],
          "crop": [
            173,
            116,
            347,
            116
          ]
        }
      ]
    },
    {
      "id": "final",
      "lane": 4,
      "row": 14,
      "kind": "merge",
      "when": "Composite (STRETCHED)",
      "title": "Stretch and composite onto the finished image",
      "text": "The finished image has been upscaled by SR to 854×480, but the blend layer is still 705×396. When merging, each window pixel p reads the blend layer at p × 705/854, stretching it over the image.",
      "imgs": [
        {
          "src": "img/sr/30-final.png",
          "caption": "final frame (854×480)",
          "size": [
            854,
            480
          ]
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "shadow",
      "to": "gbuf",
      "label": "",
      "style": "pack"
    },
    {
      "from": "gbuf",
      "to": "noHand",
      "label": "copy at scene size",
      "style": "depth"
    },
    {
      "from": "gbuf",
      "to": "hand",
      "label": "",
      "style": "pack"
    },
    {
      "from": "noHand",
      "to": "probe",
      "label": "skipped while SR is in use",
      "style": "probe"
    },
    {
      "from": "hand",
      "to": "transl",
      "label": "",
      "style": "pack"
    },
    {
      "from": "hand",
      "to": "opaque",
      "label": "copy at scene size",
      "style": "depth"
    },
    {
      "from": "transl",
      "to": "packframe",
      "label": "",
      "style": "pack"
    },
    {
      "from": "transl",
      "to": "mainEnd",
      "label": "read directly at end of frame",
      "style": "depth"
    },
    {
      "from": "collect",
      "to": "seed",
      "label": "after the pack finishes",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "seed",
      "label": "world blocks the channel",
      "style": "depth"
    },
    {
      "from": "noHand",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "mainEnd",
      "to": "transMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "seed",
      "to": "draw",
      "label": "",
      "style": "depth"
    },
    {
      "from": "draw",
      "to": "fold",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "others",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "layer1",
      "label": "",
      "style": "merge"
    },
    {
      "from": "handMask",
      "to": "layer1",
      "label": "hand pixels not drawn",
      "style": "merge"
    },
    {
      "from": "transMask",
      "to": "layer1",
      "label": "darkened behind glass",
      "style": "merge"
    },
    {
      "from": "others",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer1",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer2",
      "to": "layer3",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer3",
      "to": "final",
      "label": "",
      "style": "merge"
    },
    {
      "from": "packframe",
      "to": "final",
      "label": "stretched over the finished image",
      "style": "merge"
    }
  ]
}
