{
  "lanes": [
    {
      "name": "光影（Iris）",
      "sub": "光影用自己的着色器画世界"
    },
    {
      "name": "场景深度",
      "sub": "EXIT 在光影画到一半时复制的深度"
    },
    {
      "name": "EXIT 通道",
      "sub": "模组的东西，用原版着色器画"
    },
    {
      "name": "合并",
      "sub": "帧末按深度叠回光影画面"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "帧开始",
      "title": "阴影 pass",
      "text": "光影画阴影贴图。EXIT 在这里什么都不画，模组的东西不会投出光影的阴影。",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "整个关卡渲染期间",
      "title": "模组提交绘制",
      "text": "<code>Exit.batch</code>、<code>draw</code>、<code>portal</code> 先把要画的东西收集起来，等光影画完再画进 EXIT 的通道。",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "光影画不透明世界",
      "text": "天空、地形、石头这些不透明的东西。顶点着色器把 xy × 0.75，所以深度缓冲里的东西缩在左下角。",
      "imgs": [
        {
          "src": "img/frame/01-pack-depth-before-hand.png",
          "caption": "光影的深度（缩放空间）"
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "复制：没有手的深度",
      "text": "手还没画。复制时按 a、b 重采样，石头回到画面里的位置。",
      "imgs": [
        {
          "src": "img/frame/02-no-hand-aligned.png",
          "caption": "对齐后"
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "光影画手",
      "text": "手也被缩放，出现在缓冲右下偏左的位置。",
      "imgs": [
        {
          "src": "img/frame/03-pack-depth-before-translucents.png",
          "caption": "加上手的深度（缩放空间）"
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "第一次 beginHand",
      "title": "量缩放：探针",
      "text": "用光影的程序画一个覆盖中间 90% 的四边形（不写颜色，画完复原深度），看深度哪里变了。测得 x 0.75、y 0.75，偏移约 0。",
      "imgs": [
        {
          "src": "img/frame/05-probe-mask.png",
          "caption": "探针落点（红）"
        }
      ]
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water 等",
      "title": "光影画半透明",
      "text": "浅蓝玻璃写进深度，但不在之前的两份复制里。",
      "imgs": [
        {
          "src": "img/frame/07-main-depth-end.png",
          "caption": "带玻璃的深度（缩放空间）"
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "复制：没有半透明的深度",
      "text": "有手、没有玻璃。同样重采样对齐。",
      "imgs": [
        {
          "src": "img/frame/04-opaque-aligned.png",
          "caption": "对齐后"
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final",
      "title": "光影的成品画面",
      "text": "光照、雾、TAAU 放大都做完了。这时画面里还没有模组的方块。",
      "imgs": [
        {
          "src": "img/frame/06-pack-frame.png",
          "caption": "光影成品"
        }
      ]
    },
    {
      "id": "mainAligned",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "帧末",
      "title": "最终深度也对齐",
      "text": "合并时要用最终深度找玻璃，同样先重采样。",
      "imgs": [
        {
          "src": "img/frame/08-main-depth-end-aligned.png",
          "caption": "对齐后（有玻璃）"
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "帧末 · 通道第一次使用",
      "title": "通道打底",
      "text": "清空通道，用“没有半透明的深度”打底，世界在前面就挡住通道；手的位置设成最近。透视通道（蓝）不让世界遮挡，只放手。",
      "imgs": [
        {
          "src": "img/frame/11-main-seeded.png",
          "caption": "主通道"
        },
        {
          "src": "img/frame/10-debug_xray-seeded.png",
          "caption": "透视通道"
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "原版着色器",
      "title": "画进通道",
      "text": "绿色写颜色和深度；红色是半透明，被石头挡掉右下角，不写深度。",
      "imgs": [
        {
          "src": "img/frame/12-main-color.png",
          "caption": "主通道颜色",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/13-main-depth.png",
          "caption": "主通道深度"
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "合并前",
      "title": "补上半透明的深度",
      "text": "半透明的东西再画一遍，只写深度到单独的缓冲，再取较近的折进通道深度，这样多个通道才能按前后排序。",
      "imgs": [
        {
          "src": "img/frame/14-main-translucent-depth.png",
          "caption": "半透明的深度"
        },
        {
          "src": "img/frame/15-main-depth-folded.png",
          "caption": "折叠后"
        }
      ]
    },
    {
      "id": "others",
      "lane": 3,
      "row": 10,
      "kind": "channel",
      "when": "每个通道",
      "title": "其他通道同样处理",
      "text": "黄色方块在 mix 通道；蓝色方块和青色线框在透视通道。",
      "imgs": [
        {
          "src": "img/frame/16-debug_mix-color.png",
          "caption": "mix 通道",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/20-debug_xray-color.png",
          "caption": "透视通道",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "handMask",
      "lane": 2,
      "row": 9,
      "kind": "depth",
      "when": "合并时",
      "title": "找手",
      "text": "“有手”和“没手”两份深度不一样的像素就是手（橙色）。通道在这里不画，手永远在最前。",
      "imgs": [
        {
          "src": "img/frame/24-hand-mask.png",
          "caption": "手的位置"
        }
      ]
    },
    {
      "id": "transMask",
      "lane": 2,
      "row": 10,
      "kind": "depth",
      "when": "合并时",
      "title": "找半透明",
      "text": "最终深度比“没有半透明的深度”更近的地方有玻璃（橙色）。通道如果在玻璃后面，就变暗到 50%。",
      "imgs": [
        {
          "src": "img/frame/25-translucent-in-front.png",
          "caption": "玻璃的位置"
        }
      ]
    },
    {
      "id": "layer1",
      "lane": 4,
      "row": 11,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "叠第一个通道",
      "text": "主通道去掉手的像素，玻璃后面的绿色下半部变暗。",
      "imgs": [
        {
          "src": "img/frame/26-layer-after-main.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/27-layer-depth-after-main.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer2",
      "lane": 4,
      "row": 12,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "按深度叠 mix 通道",
      "text": "每个像素比较深度，近的在前：绿色挡住黄色重叠的部分。",
      "imgs": [
        {
          "src": "img/frame/28-layer-after-debug_mix.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/29-layer-depth-after-debug_mix.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer3",
      "lane": 4,
      "row": 13,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "叠透视通道",
      "text": "蓝色方块和线框加入混合层。",
      "imgs": [
        {
          "src": "img/frame/30-layer-after-debug_xray.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/31-layer-depth-after-debug_xray.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "final",
      "lane": 4,
      "row": 14,
      "kind": "merge",
      "when": "Composite",
      "title": "叠回光影画面",
      "text": "混合层按透明度盖到光影成品上，得到最终画面。",
      "imgs": [
        {
          "src": "img/frame/32-final.png",
          "caption": "最终画面"
        }
      ]
    }
  ],
