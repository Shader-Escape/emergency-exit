{
  "lanes": [
    {
      "name": "Shader pack (Iris)",
      "sub": "the pack draws the world with its own shaders"
    },
    {
      "name": "Scene depth",
      "sub": "depth EXIT copies while the pack is halfway through the frame"
    },
    {
      "name": "EXIT channels",
      "sub": "the mod's own objects, drawn with vanilla shaders"
    },
    {
      "name": "Merge",
      "sub": "at the end of the frame, blended back over the pack's image by depth"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "frame start",
      "title": "Shadow pass",
      "text": "The pack draws its shadow map. EXIT draws nothing here, so the mod's objects do not cast shadows in the pack.",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "throughout level rendering",
      "title": "Mod submits draws",
      "text": "<code>Exit.batch</code>, <code>draw</code> and <code>portal</code> first collect what to draw, then draw it into EXIT's channels after the pack finishes.",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "Pack draws opaque world",
      "text": "Sky, terrain and stone, the opaque things. The vertex shader multiplies xy by 0.75, so only the lower-left corner (dashed box) of the depth buffer has content.",
      "imgs": [
        {
          "src": "img/frame/01-pack-depth-before-hand.png",
          "caption": "pack depth (scaled space)",
          "box": [
            0,
            120,
            640.5,
            360
          ]
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "Copy: depth without hand",
      "text": "The hand is not drawn yet. The copy resamples with a and b, so the stone returns to its place in the image.",
      "imgs": [
        {
          "src": "img/frame/02-no-hand-aligned.png",
          "caption": "aligned"
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "Pack draws the hand",
      "text": "The hand is scaled too, and appears in the lower-right part of the buffer, slightly left of the corner.",
      "imgs": [
        {
          "src": "img/frame/03-pack-depth-before-translucents.png",
          "caption": "depth with hand (scaled space)",
          "box": [
            0,
            120,
            640.5,
            360
          ]
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "first beginHand",
      "title": "Measure the scale: probe",
      "text": "Draw a quad covering the middle 90% with the pack's program (writes no color, restores the depth afterwards), then see where the depth changed. Measured x 0.75, y 0.75, offset about 0.",
      "imgs": [
        {
          "src": "img/frame/05-probe-mask.png",
          "caption": "probe landing (red); the dashed line is where it would be without scaling",
          "box": [
            42.7,
            24,
            768.6,
            432
          ]
        }
      ]
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water etc.",
      "title": "Pack draws translucents",
      "text": "The pale blue glass is written to depth, but it is not in the two copies above.",
      "imgs": [
        {
          "src": "img/frame/07-main-depth-end.png",
          "caption": "depth with glass (scaled space)",
          "box": [
            0,
            120,
            640.5,
            360
          ]
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "Copy: depth without translucents",
      "text": "Has the hand, no glass. Resampled and aligned the same way.",
      "imgs": [
        {
          "src": "img/frame/04-opaque-aligned.png",
          "caption": "aligned"
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final",
      "title": "Pack's finished frame",
      "text": "Lighting, fog and the TAAU upscale are all done. There are no mod objects in the image yet.",
      "imgs": [
        {
          "src": "img/frame/06-pack-frame.png",
          "caption": "pack's finished image"
        }
      ]
    },
    {
      "id": "mainAligned",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "end of frame",
      "title": "Final depth, also aligned",
      "text": "The merge uses the final depth to find the glass, so it is resampled first.",
      "imgs": [
        {
          "src": "img/frame/08-main-depth-end-aligned.png",
          "caption": "aligned (with glass)"
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "end of frame · first use of the channel",
      "title": "Seed the channel",
      "text": "Clear the channel and seed it with \"depth without translucents\", so the world in front blocks the channel. The hand's position is set to nearest. The see-through channel (blue) is not blocked by the world; it only holds the hand.",
      "imgs": [
        {
          "src": "img/frame/11-main-seeded.png",
          "caption": "main channel"
        },
        {
          "src": "img/frame/10-debug_xray-seeded.png",
          "caption": "see-through channel"
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "vanilla shaders",
      "title": "Draw into the channel",
      "text": "Green writes color and depth. Red is translucent: the stone cuts off its lower-right corner, and it does not write depth.",
      "imgs": [
        {
          "src": "img/frame/12-main-color.png",
          "caption": "main channel color",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/13-main-depth.png",
          "caption": "main channel depth"
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "before merging",
      "title": "Add the translucent depth",
      "text": "The translucent objects are drawn again, writing only depth into a separate buffer. The nearer value is then folded into the channel's depth, so several channels can be sorted front to back.",
      "imgs": [
        {
          "src": "img/frame/14-main-translucent-depth.png",
          "caption": "translucent depth"
        },
        {
          "src": "img/frame/15-main-depth-folded.png",
          "caption": "folded"
        }
      ]
    },
    {
      "id": "others",
      "lane": 3,
      "row": 10,
      "kind": "channel",
      "when": "each channel",
      "title": "Other channels, same treatment",
      "text": "The yellow block is in the mix channel; the blue block and the cyan wireframe are in the see-through channel.",
      "imgs": [
        {
          "src": "img/frame/16-debug_mix-color.png",
          "caption": "mix channel",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/20-debug_xray-color.png",
          "caption": "see-through channel",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "handMask",
      "lane": 2,
      "row": 9,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the hand",
      "text": "The pixels where the \"with hand\" and \"without hand\" depths differ are the hand (orange). No channel is drawn here, so the hand is always in front.",
      "imgs": [
        {
          "src": "img/frame/24-hand-mask.png",
          "caption": "hand position"
        }
      ]
    },
    {
      "id": "transMask",
      "lane": 2,
      "row": 10,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the translucents",
      "text": "Where the final depth is nearer than \"depth without translucents\", there is glass (orange). If a channel is behind the glass, it is darkened to 50%.",
      "imgs": [
        {
          "src": "img/frame/25-translucent-in-front.png",
          "caption": "glass position"
        }
      ]
    },
    {
      "id": "layer1",
      "lane": 4,
      "row": 11,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the first channel",
      "text": "The main channel drops the hand's pixels, and the lower half of the green behind the glass is darkened.",
      "imgs": [
        {
          "src": "img/frame/26-layer-after-main.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/27-layer-depth-after-main.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer2",
      "lane": 4,
      "row": 12,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the mix channel by depth",
      "text": "Each pixel compares depths, and the nearer one is in front: the green covers the overlapping part of the yellow.",
      "imgs": [
        {
          "src": "img/frame/28-layer-after-debug_mix.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/29-layer-depth-after-debug_mix.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer3",
      "lane": 4,
      "row": 13,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the see-through channel",
      "text": "The blue block and the wireframe are added to the blend layer.",
      "imgs": [
        {
          "src": "img/frame/30-layer-after-debug_xray.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/frame/31-layer-depth-after-debug_xray.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "final",
      "lane": 4,
      "row": 14,
      "kind": "merge",
      "when": "Composite",
      "title": "Composite onto the pack's image",
      "text": "The blend layer is laid over the pack's finished image by its transparency, giving the final frame.",
      "imgs": [
        {
          "src": "img/frame/32-final.png",
          "caption": "final frame"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "shadow",
      "to": "gbuf",
      "label": "",
      "style": "pack"
    },
    {
      "from": "gbuf",
      "to": "noHand",
      "label": "copy + resample",
      "style": "depth"
    },
    {
      "from": "gbuf",
      "to": "hand",
      "label": "",
      "style": "pack"
    },
    {
      "from": "noHand",
      "to": "probe",
      "label": "first time: measure scale",
      "style": "probe"
    },
    {
      "from": "hand",
      "to": "transl",
      "label": "",
      "style": "pack"
    },
    {
      "from": "hand",
      "to": "opaque",
      "label": "copy + resample",
      "style": "depth"
    },
    {
      "from": "transl",
      "to": "packframe",
      "label": "",
      "style": "pack"
    },
    {
      "from": "transl",
      "to": "mainAligned",
      "label": "end-of-frame copy + resample",
      "style": "depth"
    },
    {
      "from": "collect",
      "to": "seed",
      "label": "after the pack finishes",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "seed",
      "label": "world blocks the channel",
      "style": "depth"
    },
    {
      "from": "noHand",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "mainAligned",
      "to": "transMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "seed",
      "to": "draw",
      "label": "",
      "style": "depth"
    },
    {
      "from": "draw",
      "to": "fold",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "others",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "layer1",
      "label": "",
      "style": "merge"
    },
    {
      "from": "handMask",
      "to": "layer1",
      "label": "hand pixels not drawn",
      "style": "merge"
    },
    {
      "from": "transMask",
      "to": "layer1",
      "label": "darkened behind glass",
      "style": "merge"
    },
    {
      "from": "others",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer1",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer2",
      "to": "layer3",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer3",
      "to": "final",
      "label": "",
      "style": "merge"
    },
    {
      "from": "packframe",
      "to": "final",
      "label": "laid over the pack's finished image",
      "style": "merge"
    }
  ]
}
