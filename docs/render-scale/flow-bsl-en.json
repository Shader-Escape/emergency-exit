{
  "lanes": [
    {
      "name": "Shader pack (Iris)",
      "sub": "the pack draws the world with its own shaders"
    },
    {
      "name": "Scene depth",
      "sub": "depth EXIT copies while the pack is halfway through the frame"
    },
    {
      "name": "EXIT channels",
      "sub": "the mod's own objects, drawn with vanilla shaders"
    },
    {
      "name": "Merge",
      "sub": "at the end of the frame, blended back over the pack's image by depth"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "frame start",
      "title": "Shadow pass",
      "text": "The pack draws its shadow map. EXIT draws nothing here.",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "throughout level rendering",
      "title": "Mod submits draws",
      "text": "<code>Exit.batch</code>, <code>draw</code> and <code>portal</code> collect what they need to draw first. Once the pack finishes, the mod draws it into EXIT's channels.",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "Pack draws opaque world",
      "text": "BSL doesn't reduce the resolution. The scene fills the whole depth buffer.",
      "imgs": [
        {
          "src": "img/bsl/01-pack-depth-before-hand.png",
          "caption": "pack depth"
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "Copy: depth without hand",
      "text": "The measured scale is full resolution, so this copy goes straight across without resampling.",
      "imgs": [
        {
          "src": "img/bsl/02-no-hand-copy.png",
          "caption": "copy"
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "Pack draws the hand",
      "text": "It just draws the hand.",
      "imgs": [
        {
          "src": "img/bsl/03-pack-depth-before-translucents.png",
          "caption": "depth with hand"
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "first beginHand",
      "title": "Measure the scale: probe",
      "text": "The probe is drawn here as well. It lands where it should, at x 0.9992 with an offset of 0.33 pixels. That's just TAA jitter, so the pipeline treats it as full resolution.",
      "imgs": [
        {
          "src": "img/bsl/05-probe-mask.png",
          "caption": "probe landing (red); the dashed line is where it should be",
          "box": [
            42.7,
            24,
            768.6,
            432
          ]
        }
      ]
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water etc.",
      "title": "Pack draws translucents",
      "text": "The pale blue glass is written to depth, but it isn't in the two copies above.",
      "imgs": [
        {
          "src": "img/bsl/07-main-depth-end.png",
          "caption": "depth with glass"
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "Copy: depth without translucents",
      "text": "It includes the hand but not the glass. It's copied directly.",
      "imgs": [
        {
          "src": "img/bsl/04-opaque-copy.png",
          "caption": "copy"
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final",
      "title": "Pack's finished frame",
      "text": "Lighting, fog and TAA are finished. The mod's draw calls aren't in the image yet.",
      "imgs": [
        {
          "src": "img/bsl/06-pack-frame.png",
          "caption": "pack's finished image"
        }
      ]
    },
    {
      "id": "mainEnd",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "end of frame",
      "title": "Use the final depth directly",
      "text": "The final depth used to find the glass at merge time needs no processing. Its pixels line up one-to-one with the channels.",
      "imgs": [
        {
          "src": "img/bsl/07-main-depth-end.png",
          "caption": "final depth"
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "end of frame, first use of the channel",
      "title": "Seed the channel",
      "text": "Clear the channel and seed it with \"depth without translucents\". The world in front then blocks the channel. The hand's position is set to nearest. The see-through channel (blue) isn't blocked by the world, and it only holds the hand.",
      "imgs": [
        {
          "src": "img/bsl/10-main-seeded.png",
          "caption": "main channel"
        },
        {
          "src": "img/bsl/09-debug_xray-seeded.png",
          "caption": "see-through channel"
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "vanilla shaders",
      "title": "Draw into the channel",
      "text": "Green writes color and depth. Red is translucent: the stone cuts off its lower-right corner, and red doesn't write depth.",
      "imgs": [
        {
          "src": "img/bsl/11-main-color.png",
          "caption": "main channel color",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/12-main-depth.png",
          "caption": "main channel depth"
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "before merging",
      "title": "Add the translucent depth",
      "text": "The translucent objects are drawn again, this time writing only depth into a separate buffer. The nearer value is folded into the channel's depth, so several channels can be sorted front to back.",
      "imgs": [
        {
          "src": "img/bsl/13-main-translucent-depth.png",
          "caption": "translucent depth"
        },
        {
          "src": "img/bsl/14-main-depth-folded.png",
          "caption": "folded"
        }
      ]
    },
    {
      "id": "others",
      "lane": 3,
      "row": 10,
      "kind": "channel",
      "when": "each channel",
      "title": "Other channels, same treatment",
      "text": "The yellow block is in the mix channel. The blue block and the cyan wireframe are in the see-through channel.",
      "imgs": [
        {
          "src": "img/bsl/15-debug_mix-color.png",
          "caption": "mix channel",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/19-debug_xray-color.png",
          "caption": "see-through channel",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "handMask",
      "lane": 2,
      "row": 9,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the hand",
      "text": "Pixels where the \"with hand\" and \"without hand\" depths differ belong to the hand (orange).",
      "imgs": [
        {
          "src": "img/bsl/23-hand-mask.png",
          "caption": "hand position"
        }
      ]
    },
    {
      "id": "transMask",
      "lane": 2,
      "row": 10,
      "kind": "depth",
      "when": "at merge",
      "title": "Find the translucents",
      "text": "Where the final depth is nearer than \"depth without translucents\", that's the glass (orange). If a channel is behind the glass, it is darkened to 50%, which fakes the translucent blend.",
      "imgs": [
        {
          "src": "img/bsl/24-translucent-in-front.png",
          "caption": "glass position"
        }
      ]
    },
    {
      "id": "layer1",
      "lane": 4,
      "row": 11,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the first channel",
      "text": "The main channel drops the hand's pixels, and the lower half of the green behind the glass is darkened.",
      "imgs": [
        {
          "src": "img/bsl/25-layer-after-main.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/26-layer-depth-after-main.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer2",
      "lane": 4,
      "row": 12,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the mix channel by depth",
      "text": "Each pixel compares depths, and the closer one wins. The green covers the part of the yellow it overlaps.",
      "imgs": [
        {
          "src": "img/bsl/27-layer-after-debug_mix.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/28-layer-depth-after-debug_mix.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer3",
      "lane": 4,
      "row": 13,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "Blend the see-through channel",
      "text": "The blue block and the wireframe are added to the blend layer.",
      "imgs": [
        {
          "src": "img/bsl/29-layer-after-debug_xray.png",
          "caption": "blend layer",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/30-layer-depth-after-debug_xray.png",
          "caption": "blend layer depth",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "final",
      "lane": 4,
      "row": 14,
      "kind": "merge",
      "when": "Composite",
      "title": "Composite onto the pack's image",
      "text": "The blend layer goes over the pack's finished image, using its transparency, to produce the final frame.",
      "imgs": [
        {
          "src": "img/bsl/31-final.png",
          "caption": "final frame"
        }
      ]
    }
  ],
  "edges": [
    {
      "from": "shadow",
      "to": "gbuf",
      "label": "",
      "style": "pack"
    },
    {
      "from": "gbuf",
      "to": "noHand",
      "label": "copied directly",
      "style": "depth"
    },
    {
      "from": "gbuf",
      "to": "hand",
      "label": "",
      "style": "pack"
    },
    {
      "from": "noHand",
      "to": "probe",
      "label": "first time: measure scale",
      "style": "probe"
    },
    {
      "from": "hand",
      "to": "transl",
      "label": "",
      "style": "pack"
    },
    {
      "from": "hand",
      "to": "opaque",
      "label": "copied directly",
      "style": "depth"
    },
    {
      "from": "transl",
      "to": "packframe",
      "label": "",
      "style": "pack"
    },
    {
      "from": "transl",
      "to": "mainEnd",
      "label": "read directly at end of frame",
      "style": "depth"
    },
    {
      "from": "collect",
      "to": "seed",
      "label": "after the pack finishes",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "seed",
      "label": "world blocks the channel",
      "style": "depth"
    },
    {
      "from": "noHand",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "opaque",
      "to": "handMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "mainEnd",
      "to": "transMask",
      "label": "",
      "style": "depth"
    },
    {
      "from": "seed",
      "to": "draw",
      "label": "",
      "style": "depth"
    },
    {
      "from": "draw",
      "to": "fold",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "others",
      "label": "",
      "style": "depth"
    },
    {
      "from": "fold",
      "to": "layer1",
      "label": "",
      "style": "merge"
    },
    {
      "from": "handMask",
      "to": "layer1",
      "label": "hand pixels not drawn",
      "style": "merge"
    },
    {
      "from": "transMask",
      "to": "layer1",
      "label": "darkened behind glass",
      "style": "merge"
    },
    {
      "from": "others",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer1",
      "to": "layer2",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer2",
      "to": "layer3",
      "label": "",
      "style": "merge"
    },
    {
      "from": "layer3",
      "to": "final",
      "label": "",
      "style": "merge"
    },
    {
      "from": "packframe",
      "to": "final",
      "label": "laid over the pack's finished image",
      "style": "merge"
    }
  ]
}
