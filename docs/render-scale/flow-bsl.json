{
  "lanes": [
    {
      "name": "光影（Iris）",
      "sub": "光影用自己的着色器画世界"
    },
    {
      "name": "场景深度",
      "sub": "EXIT 在光影画到一半时复制的深度"
    },
    {
      "name": "EXIT 通道",
      "sub": "模组的东西，用原版着色器画"
    },
    {
      "name": "合并",
      "sub": "帧末按深度叠回光影画面"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "帧开始",
      "title": "阴影 pass",
      "text": "光影画阴影贴图。EXIT 在这里不画任何东西。",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "整个关卡渲染期间",
      "title": "模组提交绘制",
      "text": "<code>Exit.batch</code>、<code>draw</code>、<code>portal</code> 先收集要画的东西，等光影画完，再画进 EXIT 的通道。",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "光影画不透明世界",
      "text": "BSL 不降分辨率。场景铺满整个深度缓冲。",
      "imgs": [
        {
          "src": "img/bsl/01-pack-depth-before-hand.png",
          "caption": "光影的深度"
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "复制：没有手的深度",
      "text": "测得的是全分辨率，直接复制，不用重采样。",
      "imgs": [
        {
          "src": "img/bsl/02-no-hand-copy.png",
          "caption": "复制"
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "光影画手",
      "text": "画手而已。",
      "imgs": [
        {
          "src": "img/bsl/03-pack-depth-before-translucents.png",
          "caption": "加上手的深度"
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "第一次 beginHand",
      "title": "量缩放：探针",
      "text": "同样画一次探针。落点就在该在的位置，测得 x 0.9992、偏移 0.33 像素。这只是 TAA 抖动，按全分辨率处理即可。",
      "imgs": [
        {
          "src": "img/bsl/05-probe-mask.png",
          "caption": "探针落点（红），虚线是应在的位置",
          "box": [
            42.7,
            24,
            768.6,
            432
          ]
        }
      ]
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water 等",
      "title": "光影画半透明",
      "text": "浅蓝色玻璃写进了深度，但不在上面两份复制里。",
      "imgs": [
        {
          "src": "img/bsl/07-main-depth-end.png",
          "caption": "带玻璃的深度"
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "复制：没有半透明的深度",
      "text": "有手，没有玻璃，直接复制。",
      "imgs": [
        {
          "src": "img/bsl/04-opaque-copy.png",
          "caption": "复制"
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final",
      "title": "光影的成品画面",
      "text": "光照、雾和 TAA 都已经做完。画面里还没有模组的绘制。",
      "imgs": [
        {
          "src": "img/bsl/06-pack-frame.png",
          "caption": "光影成品"
        }
      ]
    },
    {
      "id": "mainEnd",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "帧末",
      "title": "最终深度直接用",
      "text": "合并时找玻璃用的最终深度不用处理，它的像素和通道一一对应。",
      "imgs": [
        {
          "src": "img/bsl/07-main-depth-end.png",
          "caption": "最终深度"
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "帧末， 通道第一次使用",
      "title": "通道打底",
      "text": "清空通道，用“没有半透明的深度”打底，前面的世界就会挡住通道。手的位置设为最近。透视通道（蓝）不会被世界挡住，只用来放手。",
      "imgs": [
        {
          "src": "img/bsl/10-main-seeded.png",
          "caption": "主通道"
        },
        {
          "src": "img/bsl/09-debug_xray-seeded.png",
          "caption": "透视通道"
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "原版着色器",
      "title": "画进通道",
      "text": "绿色写颜色和深度。红色是半透明的，被石头挡住右下角，而且不写深度。",
      "imgs": [
        {
          "src": "img/bsl/11-main-color.png",
          "caption": "主通道颜色",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/12-main-depth.png",
          "caption": "主通道深度"
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "合并前",
      "title": "补上半透明的深度",
      "text": "把半透明的东西再画一遍，只把深度写进单独的缓冲，再取较近的值折进通道的深度。这样多个通道就能按前后顺序排序。",
      "imgs": [
        {
          "src": "img/bsl/13-main-translucent-depth.png",
          "caption": "半透明的深度"
        },
        {
          "src": "img/bsl/14-main-depth-folded.png",
          "caption": "折叠后"
        }
      ]
    },
    {
      "id": "others",
      "lane": 3,
      "row": 10,
      "kind": "channel",
      "when": "每个通道",
      "title": "其他通道同样处理",
      "text": "黄色方块在 mix 通道里；蓝色方块和青色线框在透视通道里。",
      "imgs": [
        {
          "src": "img/bsl/15-debug_mix-color.png",
          "caption": "mix 通道",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/19-debug_xray-color.png",
          "caption": "透视通道",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "handMask",
      "lane": 2,
      "row": 9,
      "kind": "depth",
      "when": "合并时",
      "title": "找手",
      "text": "“有手”和“没手”两份深度中不同的像素就是手（橙色）。",
      "imgs": [
        {
          "src": "img/bsl/23-hand-mask.png",
          "caption": "手的位置"
        }
      ]
    },
    {
      "id": "transMask",
      "lane": 2,
      "row": 10,
      "kind": "depth",
      "when": "合并时",
      "title": "找半透明",
      "text": "最终深度比“没有半透明的深度”更近的地方就是玻璃（橙色）。如果通道在玻璃后面，就压暗到 50%伪造混合。",
      "imgs": [
        {
          "src": "img/bsl/24-translucent-in-front.png",
          "caption": "玻璃的位置"
        }
      ]
    },
    {
      "id": "layer1",
      "lane": 4,
      "row": 11,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "叠第一个通道",
      "text": "主通道去掉手的像素，玻璃后面的绿色下半部分被压暗。",
      "imgs": [
        {
          "src": "img/bsl/25-layer-after-main.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/26-layer-depth-after-main.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer2",
      "lane": 4,
      "row": 12,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "按深度叠 mix 通道",
      "text": "逐像素比较深度，近的在前：绿色挡住与黄色重叠的部分。",
      "imgs": [
        {
          "src": "img/bsl/27-layer-after-debug_mix.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/28-layer-depth-after-debug_mix.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "layer3",
      "lane": 4,
      "row": 13,
      "kind": "merge",
      "when": "ChannelBlend",
      "title": "叠透视通道",
      "text": "蓝色方块和线框加入混合层。",
      "imgs": [
        {
          "src": "img/bsl/29-layer-after-debug_xray.png",
          "caption": "混合层",
          "crop": [
            210,
            140,
            420,
            140
          ]
        },
        {
          "src": "img/bsl/30-layer-depth-after-debug_xray.png",
          "caption": "混合层深度",
          "crop": [
            210,
            140,
            420,
            140
          ]
        }
      ]
    },
    {
      "id": "final",
      "lane": 4,
      "row": 14,
      "kind": "merge",
      "when": "Composite",
      "title": "叠回光影画面",
      "text": "混合层按透明度盖到光影的成品画面上，得到最终的画面。",
      "imgs": [
        {
          "src": "img/bsl/31-final.png",
          "caption": "最终画面"
        }
      ]
    }
  ],
