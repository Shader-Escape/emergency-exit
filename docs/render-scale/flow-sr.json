{
  "lanes": [
    {
      "name": "光影（Iris）",
      "sub": "光影用自己的着色器画世界"
    },
    {
      "name": "场景深度",
      "sub": "EXIT 在光影画到一半时复制的深度"
    },
    {
      "name": "EXIT 通道",
      "sub": "模组的东西，用原版着色器画"
    },
    {
      "name": "合并",
      "sub": "帧末按深度叠回光影画面"
    }
  ],
  "nodes": [
    {
      "id": "shadow",
      "lane": 1,
      "row": 2,
      "kind": "pack",
      "when": "帧开始",
      "title": "阴影 pass",
      "text": "光影画阴影贴图。EXIT 在这里不画任何东西。",
      "imgs": []
    },
    {
      "id": "collect",
      "lane": 3,
      "row": 2,
      "kind": "channel",
      "when": "整个关卡渲染期间",
      "title": "模组提交绘制",
      "text": "<code>Exit.batch</code>、<code>draw</code>、<code>portal</code> 先收集要画的东西，等光影画完，再画进 EXIT 的通道。",
      "imgs": []
    },
    {
      "id": "gbuf",
      "lane": 1,
      "row": 3,
      "kind": "pack",
      "when": "gbuffers",
      "title": "光影画不透明世界",
      "text": "Super Resolution 让光影只在窗口的 1/1.21 里画：窗口 854×480，场景 705×396。深度缓冲仍是 854×480，只用到左下角（虚线框）。",
      "imgs": [
        {
          "src": "img/sr/01-pack-depth-before-hand.png",
          "caption": "光影的深度（854×480）",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "noHand",
      "lane": 2,
      "row": 3,
      "kind": "depth",
      "when": "Iris beginHand",
      "title": "复制：没有手的深度",
      "text": "EXIT 从 SR 那里读到场景尺寸 705×396，就按这个尺寸从左下角复制。拿到的正好是整幅场景，不需要重采样。",
      "imgs": [
        {
          "src": "img/sr/02-no-hand-copy.png",
          "caption": "复制（705×396）",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "hand",
      "lane": 1,
      "row": 4,
      "kind": "pack",
      "when": "gbuffers_hand",
      "title": "光影画手",
      "text": "手也画在左下角这一块里。",
      "imgs": [
        {
          "src": "img/sr/03-pack-depth-before-translucents.png",
          "caption": "加上手的深度（854×480）",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "probe",
      "lane": 2,
      "row": 4,
      "kind": "probe",
      "when": "第一次 beginHand",
      "title": "不测缩放",
      "text": "SR 在用的时候，EXIT 不画探针。SR 的缩小已经由场景尺寸处理了，再测一次就会把场景缩小两次。",
      "imgs": []
    },
    {
      "id": "transl",
      "lane": 1,
      "row": 5,
      "kind": "pack",
      "when": "gbuffers_water 等",
      "title": "光影画半透明",
      "text": "浅蓝色玻璃写进深度。",
      "imgs": [
        {
          "src": "img/sr/06-main-depth-end.png",
          "caption": "带玻璃的深度（854×480）",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "opaque",
      "lane": 2,
      "row": 5,
      "kind": "depth",
      "when": "Iris beginTranslucents",
      "title": "复制：没有半透明的深度",
      "text": "有手，没有玻璃，同样按场景尺寸复制。",
      "imgs": [
        {
          "src": "img/sr/04-opaque-copy.png",
          "caption": "复制（705×396）",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "packframe",
      "lane": 1,
      "row": 6,
      "kind": "pack",
      "when": "deferred → composite → final → SR",
      "title": "光影的成品画面",
      "text": "光影画完后，SR（这里用 FSR2）把 705×396 放大到整个窗口。画面里还没有模组的绘制。",
      "imgs": [
        {
          "src": "img/sr/05-pack-frame.png",
          "caption": "放大后的成品（854×480）",
          "size": [
            854,
            480
          ]
        }
      ]
    },
    {
      "id": "mainEnd",
      "lane": 2,
      "row": 6,
      "kind": "depth",
      "when": "帧末",
      "title": "最终深度不用对齐",
      "text": "合并时找玻璃用的最终深度也只读左下角 705×396 这一块，像素和通道一一对应。",
      "imgs": [
        {
          "src": "img/sr/06-main-depth-end.png",
          "caption": "读的是虚线框里",
          "size": [
            854,
            480
          ],
          "box": [
            0,
            84,
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "seed",
      "lane": 3,
      "row": 7,
      "kind": "channel",
      "when": "帧末， 通道第一次使用",
      "title": "通道打底",
      "text": "通道和场景一样大，都是 705×396。用“没有半透明的深度”打底，手的位置设为最近；透视通道只放手。",
      "imgs": [
        {
          "src": "img/sr/09-main-seeded.png",
          "caption": "主通道",
          "size": [
            705,
            396
          ]
        },
        {
          "src": "img/sr/08-debug_xray-seeded.png",
          "caption": "透视通道",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "draw",
      "lane": 3,
      "row": 8,
      "kind": "channel",
      "when": "原版着色器",
      "title": "画进通道",
      "text": "绿色写颜色和深度。红色是半透明的，被石头挡住右下角，而且不写深度。",
      "imgs": [
        {
          "src": "img/sr/10-main-color.png",
          "caption": "主通道颜色",
          "size": [
            705,
            396
