          "crop": [
            173,
            116,
            347,
            116
          ]
        },
        {
          "src": "img/sr/11-main-depth.png",
          "caption": "主通道深度",
          "size": [
            705,
            396
          ]
        }
      ]
    },
    {
      "id": "fold",
      "lane": 3,
      "row": 9,
      "kind": "channel",
      "when": "合并前",
      "title": "补上半透明的深度",
      "text": "半透明的东西再画一遍，只写深度，再折进通道的深度。",
      "imgs": [
        {
          "src": "img/sr/12-main-translucent-depth.png",
